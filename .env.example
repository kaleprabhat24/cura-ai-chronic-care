# Cura AI backend configuration. Copy to `.env` (git-ignored) and adjust; every value has a working
# local default, so the backend also runs with no .env at all.

# development | test | production
ENVIRONMENT=development

# Default: a local SQLite file (no server, no Docker, no cloud account needed).
DATABASE_URL=sqlite:///backend/var/cura_dev.db
# PostgreSQL works without code changes (install the driver: pip install -e "backend[postgres]"):
# DATABASE_URL=postgresql+psycopg://cura:change-me@localhost:5432/cura

# Authentication. "dev" = local development identity headers (X-Dev-User / X-Dev-Role); it refuses to
# run when ENVIRONMENT=production. "supabase" is reserved for the final milestone and is NOT
# implemented yet (the app refuses to start with it).
AUTH_MODE=dev

# Inputs produced by the ML pipeline (defaults shown; paths are relative to the project root or absolute)
DATASET_DIR=ml/data/v1
MODEL_BUNDLE_DIR=ml/artifacts/models/cura-fu-1.0.0
MODEL_ARTIFACTS_ROOT=ml/artifacts/models

# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

SQL_ECHO=false
