# Cura AI backend configuration — variable names only. Copy to `.env` (git-ignored) and fill in what
# you need. Every variable is optional for local development: with no .env at all the API uses
# SQLite at backend/var/cura_dev.db and development sign-in. Never commit real values.

# development | test | production   (production refuses AUTH_MODE=dev and SQLite)
ENVIRONMENT=

# Database. Local default: SQLite. For Supabase use the session-pooler URI from
# Project Settings → Database (postgres://… or postgresql://… are both accepted).
DATABASE_URL=
# PostgreSQL only: SSL mode (Supabase: require), pool size, and prepared statements off for the
# transaction pooler (port 6543).
DATABASE_SSLMODE=
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=
DATABASE_POOL_RECYCLE_SECONDS=
DATABASE_DISABLE_PREPARED_STATEMENTS=

# Authentication: dev (local identity headers, never in production) | supabase
AUTH_MODE=
# Supabase mode: project URL (tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_URL=
# Optional overrides: expected audience (default "authenticated"), JWKS URL, and the legacy HS256 JWT
# secret — only for projects that still use the legacy shared secret. This is a SECRET.
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# Browser origins allowed to call the API, as a JSON list, e.g. ["https://your-app.vercel.app"]
CORS_ORIGINS=

# ML artefacts (defaults: ml/data/v1, ml/artifacts/models/cura-fu-1.0.0, ml/artifacts/models, ml/reports)
DATASET_DIR=
MODEL_BUNDLE_DIR=
MODEL_ARTIFACTS_ROOT=
MODEL_REPORTS_DIR=

SQL_ECHO=
