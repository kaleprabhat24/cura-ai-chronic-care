# Cura AI frontend configuration (variable names only; copy to .env.local and fill in).
# Only NEXT_PUBLIC_* values are sent to the browser. Never put a Supabase service-role key or a
# database password in this file.

# Base URL of the FastAPI backend, without a trailing slash (local default: http://127.0.0.1:8000)
NEXT_PUBLIC_API_BASE_URL=

# "dev" (local development identity picker; the backend must also run AUTH_MODE=dev) or "supabase"
NEXT_PUBLIC_AUTH_MODE=

# Supabase mode only: project URL and the public anon / publishable key (safe for browsers)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "production" disables the dev identity picker even if NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_APP_ENV=
